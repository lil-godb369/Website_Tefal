# Chép thành .env.local rồi điền. Không đưa .env.local lên git.
# Lấy ở Supabase > Project Settings > API (project riêng của Tefal Web).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Địa chỉ web khi chạy thật (dùng cho sitemap, thẻ og, đường dẫn đăng nhập Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
